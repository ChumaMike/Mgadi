# Copy this file to .env.local. Never commit .env.local.
# Leave this empty for the safe built-in rules fallback.
ANTHROPIC_API_KEY=
MGADI_MODEL=claude-sonnet-4-20250514
# MGADI_AI=off

# The local server listens on every network interface by default so a phone on your wifi can open it. When real keys are set, keep it on this
# computer only. (A page served over plain http on the wifi is also not a secure context: the microphone and the operator token will not work there.)
# HOST=127.0.0.1

# --- Voice companion: OFF by default. Real provider calls need explicit approval. See VOICE-REAL-TEST.md. ---
# MGADI_VOICE_MODE=off            # off | mock (labelled simulation, no provider) | retell
# RETELL_API_KEY=                 # PRIVATE. Server only. Never commit or paste into chat.
# RETELL_PUBLIC_KEY=              # public_key_..., allowed domains only; live-transcript socket. Not in /api/voice/config.
# RETELL_AGENT_ID_EN=
# RETELL_AGENT_ID_AF=             # only if Afrikaans is pursued; stays blocked until the guide is fully translated
# RETELL_AGENT_VERSION=           # pin the agent version that was preflighted (number)
# MGADI_TRANSCRIPTS=              # leave empty for live captions via the public key; "off" keeps every key out of the browser
# MGADI_VOICE_VERIFIED_LANGUAGES= # PUBLIC availability. e.g. en. Only after real speaker/audio/privacy/cost tests pass.
# MGADI_VOICE_MAX_MINUTES=10
# MGADI_VOICE_PER_CLIENT=3        # voice sessions per visitor per 10 minutes
# MGADI_VOICE_PER_HOUR=20         # voice sessions per hour in total
# MGADI_VOICE_DAILY_SESSIONS=100  # voice sessions per rolling day in total
# MGADI_VOICE_DAILY_MINUTES=      # worst-case audio minutes per day (default: sessions x max minutes, capped at 600)

# --- Operator test access: for the person doing the FIRST real call. Not public availability. ---
# MGADI_OPERATOR_TOKEN=           # 24+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MGADI_OPERATOR_MAX_MINUTES=3    # length cap on test calls
# MGADI_OPERATOR_MAX_SESSIONS_PER_DAY=5
# MGADI_OPERATOR_ALLOW_PRODUCTION= # "yes" only if you knowingly allow operator tests on a production deployment

# --- Shared quota store (REQUIRED for public voice on Vercel). Upstash-REST compatible. ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
