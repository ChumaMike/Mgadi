# Copy this file to .env.local. Never commit .env.local.
# Leave this empty for the safe built-in rules fallback.
ANTHROPIC_API_KEY=
MGADI_MODEL=claude-sonnet-4-20250514
# MGADI_AI=off

# --- Voice companion: OFF by default. Real provider calls need explicit approval. ---
# MGADI_VOICE_MODE=off            # off | mock (labelled simulation, no provider) | retell
# RETELL_API_KEY=                 # PRIVATE. Server only. Never commit or paste into chat.
# RETELL_PUBLIC_KEY=              # public_key_..., allowed domains only; used for the live-transcript socket
# RETELL_AGENT_ID_EN=
# RETELL_AGENT_ID_AF=
# MGADI_VOICE_VERIFIED_LANGUAGES= # e.g. en,af, only after speakers of that language have tested it
# MGADI_VOICE_MAX_MINUTES=10
# MGADI_VOICE_PER_CLIENT=3        # voice sessions per visitor per 10 minutes
# MGADI_VOICE_PER_HOUR=20         # voice sessions per hour in total
